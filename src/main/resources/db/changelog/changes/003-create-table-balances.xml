<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-balance-table" author="allar.ounsaar">
        <createTable tableName="balance">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_balance_account_id" references="account(id)"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="NUMERIC(19,4)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="balance" columnNames="account_id, currency" constraintName="uq_account_currency"/>

        <createIndex tableName="balance" indexName="idx_balance_account_id">
            <column name="account_id"/>
        </createIndex>

        <sql splitStatements="false">
            CREATE TRIGGER trg_balance_updated_at
                BEFORE UPDATE
                ON balance
                FOR EACH ROW EXECUTE FUNCTION set_updated_at();
        </sql>
    </changeSet>
</databaseChangeLog>