<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ee.allar.bank.account.mapper.AccountMapper">

    <insert id="insert"
            parameterType="ee.allar.bank.account.Account"
            useGeneratedKeys="true"
            keyProperty="id,createdAt,updatedAt"
            keyColumn="id,created_at,updated_at">
        INSERT INTO account (customer_id, country)
        VALUES (#{customerId}, #{country})
    </insert>

    <select id="findById" resultType="ee.allar.bank.account.Account">
        SELECT id, customer_id, country, created_at, updated_at
        FROM account
        WHERE id = #{id}
    </select>

</mapper>