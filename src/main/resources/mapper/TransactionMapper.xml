<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ee.allar.bank.transaction.mapper.TransactionMapper">

    <resultMap id="TransactionResultMap" type="ee.allar.bank.transaction.Transaction">
        <id property="id" column="id"/>
        <result property="accountId" column="account_id"/>
        <result property="balanceId" column="balance_id"/>
        <result property="amount" column="amount" typeHandler="ee.allar.bank.typehandler.MonetaryAmountTypeHandler"/>
        <result property="currency" column="currency"/>
        <result property="direction" column="direction"/>
        <result property="description" column="description"/>
        <result property="balanceAfter" column="balance_after" typeHandler="ee.allar.bank.typehandler.MonetaryAmountTypeHandler"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="ee.allar.bank.transaction.Transaction"
            useGeneratedKeys="true"
            keyProperty="id,createdAt,updatedAt"
            keyColumn="id,created_at,updated_at">
        INSERT INTO transaction (account_id, balance_id, amount, currency, direction, description, balance_after)
        VALUES (#{accountId}, #{balanceId}, #{amount}, #{currency}, #{direction}, #{description}, #{balanceAfter})
    </insert>

    <select id="findAllByAccountId" resultMap="TransactionResultMap">
        SELECT id,
               account_id,
               balance_id,
               amount,
               currency,
               direction,
               description,
               balance_after,
               created_at,
               updated_at
        FROM transaction
        WHERE account_id = #{accountId}
    </select>

</mapper>